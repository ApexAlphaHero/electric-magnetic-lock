# Installed to /etc/sudoers.d/door_update (mode 0440, validated with visudo -c).
#
# The web admin runs as the unprivileged `doorweb` user with no write access to
# /opt/door_access. This grants it exactly two things: ask systemd to start the
# updater, and ask whether it is still running. It cannot start any other unit,
# cannot stop or disable anything, and gets no shell.
#
# Note this is still a privilege boundary worth understanding: anyone holding a
# dooradmin web session can trigger code from the configured git remote to run
# as root. update.sh refuses to pull from any other remote for that reason.

Cmnd_Alias DOOR_UPDATE = /usr/bin/systemctl start door_update.service, \
                         /usr/bin/systemctl start door_update_check.service, \
                         /usr/bin/systemctl is-active door_update.service, \
                         /usr/bin/systemctl is-active door_update_check.service

doorweb ALL=(root) NOPASSWD: DOOR_UPDATE
